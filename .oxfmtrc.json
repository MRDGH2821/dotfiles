{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxfmt/configuration_schema.json",
  "associations": [
    {
      "files": ["*.jsonc", "*.json"],
      "language": "json"
    }
  ],
  "ignorePatterns": [
    "**/*.lock",
    "**/.mise/**",
    "**/go.sum",
    "**/locks/**",
    "**/npm-shrinkwrap.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/pam.d/**",
    "*.*ignore",
    ".chezmoiignore",
    ".chezmoiroot",
    "dot_zshrc",
    "private_spectaclerc.tmpl"
  ],
  "jsdoc": true,
  "overrides": [
    {
      "files": ["*.jsonc", "*.json"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "printWidth": 80,
  "singleAttributePerLine": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false
}
