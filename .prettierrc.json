{
  "goTemplateBracketSpacing": true,
  "overrides": [
    {
      "files": ["*.jsonc", "*.json"],
      "options": {
        "parser": "json",
        "trailingComma": "none"
      }
    },
    {
      "files": [
        "konsolerc",
        "dolphinrc",
        ".editorconfig",
        "**/git/config",
        "dot_shellcheckrc",
        "**/konsole/*.profile"
      ],
      "options": {
        "parser": "ini"
      }
    },
    
    
  ],
  "plugins": [
    "prettier-plugin-go-template",
    "prettier-plugin-powershell",
    "prettier-plugin-sh"
  ],
  "powershellIndentSize": 2,
  "powershellRewriteAliases": true,
  "powershellRewriteWriteHost": true,

  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false
}
