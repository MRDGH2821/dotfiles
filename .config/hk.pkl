amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

local sorters = new Group {
  steps {
    ["cspell-sort"] {
      glob =
        List(
          "**/.cSpell*",
          "**/.cspell*",
          "**/cSpell*",
          "**/cspell*",
          ".cSpell*",
          ".cspell*",
          "cSpell*",
          "cspell*",
        )
      fix =
        """
        failed=0
        for f in {{ files }}; do
        yq -i '.words|= sort_by(downcase)|.ignorePaths|=sort_by(downcase)' "$f" || failed=1
        done
        exit $failed
        """
    }
    ["jscpd-sort"] {
      glob = List("**/.jscpd*", "**/jscpd*", ".jscpd*", "jscpd*")
      fix =
        """
        failed=0
        for f in {{ files }}; do
        yq -i '.ignore|= sort_by(downcase)|.reporters|=sort_by(downcase)' "$f" || failed=1
        done
        exit $failed
        """
    }
    ["keep-sorted"] {
      check = "keep-sorted --mode lint {{files}}"
      fix = "keep-sorted --mode fix {{files}}"
    }
    ["toml-sort"] {
      check = "toml-sort --check --sort-table-keys --sort-inline-tables {{files}}"
      exclude = List("**/tombi.toml")
      fix = "toml-sort --in-place --sort-table-keys --sort-inline-tables {{files}}"
      types = List("toml")
    }
    ["key-sort"] {
      fix =
        """
        failed=0
        for f in {{ files }}; do
        yq -iP 'sort_keys(..)' "$f" || failed=1
        done
        exit $failed
        """
      types = List("json", "yaml")
      exclude = "*.jsonc"
    }
    ["gitignore-tidy"] {
      check = "gitignore-tidy {{files}}"
      fix = "gitignore-tidy {{files}}"
      glob = List("**/.*ignore", ".*ignore")
      exclude = "**/.chezmoiignore"
    }
  }
}

local linters = new Mapping<String, Step> {
  // Secrets
  ["betterleaks"] = Builtins.betterleaks
  ["detect-private-key"] = Builtins.detect_private_key

  // Config Files
  ["pkl"] = Builtins.pkl
  ["pkl_format"] = Builtins.pkl_format
  ["tombi"] = Builtins.tombi
  ["tombi_format"] = (Builtins.tombi_format) { depends = List("sorters") }

  // Misc
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_shebang_scripts_are_executable"] = Builtins.check_shebang_scripts_are_executable
  ["check-placeholders"] {
    check =
      "if grep -EIn '(<placeholder>|CHANGEME|FILL_ME_IN|NOCOMMIT)' {{files}}; then false; else test $? -eq 1; fi"
    exclude = List("template/**", ".config/hk.pkl", ".config/cspell.json")
  }
  ["ls_lint"] = Builtins.ls_lint
  ["xmllint"] = (Builtins.xmllint) {
    // shortcut: xmllint can alter mixed-content whitespace; use a preservation-aware formatter when XML text depends on exact spacing.
    glob = List("**/*.xml", "**/dolphinui.rc") // cspell:ignore dolphinui
    exclude =
      List(
        "**/pam.d/**",
        "*.*ignore",
        ".chezmoiignore",
        ".chezmoiroot",
        "dot_zshrc",
        // cspell:ignore spectaclerc tmpl
        "private_spectaclerc.tmpl",
      )
    fix =
      """
      for file in {{files}}; do
      tmp=$(mktemp "${file}.tmp.XXXXXX") || exit 1
      if XMLLINT_INDENT="  " xmllint --format --encode UTF-8 --output "$tmp" "$file" &&
        mv "$tmp" "$file"; then
      :
      else
      rm -f "$tmp"
      exit 1
      fi
      done
      """
  }

  // Python
  ["ruff"] = Builtins.ruff
  ["ruff_format"] = Builtins.ruff_format

  // Text
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["rumdl"] = (Builtins.rumdl) { depends = List("rumdl-format") }
  ["rumdl_format"] = Builtins.rumdl_format
  ["ryl"] = Builtins.ryl
  ["ryl_markdown"] = Builtins.ryl_markdown
  ["sort-markdown-tables"] {
    check = "smt --check {{files}}"
    fix = "smt --in-place {{files}}"
    types = List("markdown")
  }

  // Style Files
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed_line_ending"] = Builtins.mixed_line_ending

  // Spell Check
  ["cspell"] {
    check = "cspell --no-must-find-files --no-progress --no-summary --gitignore --files {{files}}"
  }
  ["typos"] = Builtins.typos
}
exclude =
  List(
    // keep-sorted start
    "**/*.lock",
    "**/.mise/**",
    "**/go.sum",
    "**/locks/**",
    "**/npm-shrinkwrap.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml"
    // keep-sorted end
  )
steps {
  ["sorters"] = sorters
  ...linters
  // AIO
  ["oxfmt"] = (Builtins.oxfmt) { depends = "sorters" }
}

hooks {
  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
      ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
      ["cspell"] {
        check =
          "cspell --no-must-find-files --no-progress --no-summary --gitignore --files {{commit_msg_file}}"
      }
      ["typos"] = Builtins.typos
    }
  }
}
