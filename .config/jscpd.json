{
  "gitignore": true,
  "ignore": [
    "**/*.svg",
    "**/*cache*/**",
    "**/.agents/**",
    "**/.chezmoidata/**",
    "**/.chezmoiscripts/**",
    "**/.git/**",
    "**/.github/**",
    "**/.idea/**",
    "**/.mise/**",
    "**/.rbenv/**",
    "**/.venv/**",
    "**/locks/**",
    "**/node_modules/**",
    "**/report/**",
    "*.lock",
    "apm.lock.yaml",
    "go.sum",
    "npm-shrinkwrap.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "template/**"
