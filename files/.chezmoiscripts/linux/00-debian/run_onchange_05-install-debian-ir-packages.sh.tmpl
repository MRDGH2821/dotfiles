{{- println "#!/usr/bin/env bash" -}}
{{- template "env_vars.tmpl" . -}}
{{- $line := "printf '%*s\\n' \"${COLUMNS:-$(tput cols)}\" '' | tr ' ' '-'" -}}

{{- template "install_ir.tmpl" . -}}

{{- if and (hasKey .chezmoi.osRelease "versionCodename") (has .chezmoi.osRelease.versionCodename .distros.debian_codes) -}}
  {{- $allPackages := list -}}
  {{- println "\necho \"Installing Debian Packages from GitHub/GitLab\"" -}}

  {{- /* ir Packages */ -}}
  {{- $irPackages := list -}}
  {{- $irPackages = concat $irPackages .debian.install_release -}}

  {{- range $irPackages -}}
    {{- println "sudo ~/.local/share/soar/bin/ir get " . -}}
    {{- println $line -}}
  {{- end -}}
{{- else -}}
  {{- fail "This script is only for Debian based systems." -}}
{{- end -}}
