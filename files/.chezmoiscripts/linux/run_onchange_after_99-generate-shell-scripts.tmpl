#!/usr/bin/env bash
set -euo pipefail

SRC_DIR="{{ .chezmoi.sourceDir }}"
TEMPLATE_DIR="${SRC_DIR}/.chezmoitemplates/shell-scripts"

BASH_MANIFEST="${HOME}/.bashrc.d/00-shell-scripts.sh"
ZSH_MANIFEST="${HOME}/.zshrc.d/00-shell-scripts.sh"

generate_manifest() {
  local manifest_path="$1"
  local shell_name="$2"
  local tmp_file="${manifest_path}.tmp.$$"

  {
    printf '# Auto-generated by chezmoi - do not edit manually\n'
    printf '# Regenerated from %s/.chezmoitemplates/shell-scripts/\n\n' "${SRC_DIR}"

    find "${TEMPLATE_DIR}" -maxdepth 1 -name '*.sh' -type f | sort | while IFS= read -r script; do
      printf '. %q\n' "${script}"
    done
  } > "${tmp_file}"

  if [[ ! -f "${manifest_path}" ]] || ! cmp -s "${tmp_file}" "${manifest_path}"; then
    mkdir -p "$(dirname "${manifest_path}")"
    mv "${tmp_file}" "${manifest_path}"
  else
    rm -f "${tmp_file}"
  fi
}

generate_manifest "${BASH_MANIFEST}" bash
generate_manifest "${ZSH_MANIFEST}" zsh
